  --wallet-gradient: linear-gradient(135deg, hsl(0 0% 95%) 0%, hsl(0 0% 100%) 100%);
  
  /* High contrast status colors */
  --success-green: hsl(0 0% 0%);
  --warning-orange: hsl(0 0% 0%);
  --error-red: hsl(0 0% 0%);
  --info-blue: hsl(0 0% 0%);
}

.high-contrast * {
  border-color: hsl(0 0% 0%) !important;
}

.high-contrast .service-card {
  border: 2px solid hsl(0 0% 0%) !important;
}

.high-contrast .status-available,
.high-contrast .status-warning,
.high-contrast .status-unavailable {
  background: hsl(0 0% 90%) !important;
  color: hsl(0 0% 0%) !important;
  border: 2px solid hsl(0 0% 0%) !important;
}

@layer base {
  * {
    border-color: hsl(var(--border));
  }

  html {
    background-color: hsl(var(--background));
    -webkit-overflow-scrolling: touch;
  }

  body {
    font-family: 'Noto Sans Arabic', 'Open Sans', sans-serif;
    background: linear-gradient(135deg, #111827 0%, #1f2937 50%, #111827 100%) !important;
    color: hsl(var(--foreground));
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    -webkit-overflow-scrolling: touch;
  }

  /* احرص على أن جذر التطبيق يطابق لون الخلفية لمنع ظهور الحواف السوداء */
  #root, #app, .app-container {
    background-color: hsl(var(--background)) !important;
    background-image: var(--app-bg, none);
    background-repeat: no-repeat;
    background-size: cover;
    background-attachment: fixed;
    -webkit-overflow-scrolling: touch;
  }

  /* توحيد إجباري لخلفية الصفحة وقياس الارتفاع لمنع الحواف السوداء */
  html, body, #root {
    background-color: hsl(var(--background)) !important;
    background: linear-gradient(135deg, #111827 0%, #1f2937 50%, #111827 100%) !important;
    background-repeat: no-repeat;
    background-size: cover;
    background-attachment: fixed;
    min-height: 100vh;
    height: 100%;
    width: 100%;
    min-width: 100%;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
  }

  /* التأكد من أن الوضع المظكن يعمل على كامل الصفحة */
  .dark {
    background: linear-gradient(135deg, #111827 0%, #1f2937 50%, #111827 100%) !important;
  }
}

