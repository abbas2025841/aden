  --donations-gradient: linear-gradient(135deg, hsl(160 50% 20%) 0%, hsl(160 50% 15%) 100%);
  --starlink-gradient: linear-gradient(135deg, hsl(200 50% 20%) 0%, hsl(200 50% 15%) 100%);
  --entertainment-gradient: linear-gradient(135deg, hsl(330 50% 20%) 0%, hsl(330 50% 15%) 100%);
  --development-gradient: linear-gradient(135deg, hsl(60 60% 25%) 0%, hsl(60 60% 20%) 100%);
  --ideas-gradient: linear-gradient(135deg, hsl(45 60% 25%) 0%, hsl(45 60% 20%) 100%);
  --currency-gradient: linear-gradient(135deg, hsl(120 50% 20%) 0%, hsl(120 50% 15%) 100%);
  --wallet-gradient: linear-gradient(135deg, hsl(120 50% 20%) 0%, hsl(120 50% 15%) 100%);

  /* Improve readability in dark */
  --text-primary: hsl(0 0% 95%);
  --text-secondary: hsl(0 0% 75%);
  --muted-foreground: hsl(210 3% 70%);
  
  /* تحسين وضوح الخطوط البيضاء في الثيم الداكن */
  .dark .service-card h3 {
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    color: white !important;
  }
  
  .dark .service-card p {
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
    color: rgba(255, 255, 255, 0.9) !important;
  }
  
  .dark .service-card button {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }
  
  .dark .service-card .status-indicator span {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
    color: rgba(255, 255, 255, 0.95) !important;
  }
}

.high-contrast {
