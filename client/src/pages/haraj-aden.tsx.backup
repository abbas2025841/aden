}

// Interfaces للبيانات
interface Ad {
  id: string;
  title: string;
  description: string;
  price: number;
  originalPrice?: number;
  category: string;
  district: string;
  seller: string;
  sellerRating: number;
  sellerAdsCount: number;
  images: string[];
  condition: string;
  negotiable: boolean;
  views: number;
  likes: number;
  postedAt: string;
  isVerified: boolean;
  isFeatured: boolean;
  contactNumber?: string;
}

interface NewAdForm {
  title: string;
  description: string;
  price: string;
  category: string;
  district: string;
  condition: string;
  negotiable: boolean;
  contactNumber: string;
  images: File[];
}

// دوال localStorage
const saveToLocalStorage = (key: string, data: any) => {
  try {
    localStorage.setItem(key, JSON.stringify(data));
  } catch (error) {
    console.error('Error saving to localStorage:', error);
  }
};

const loadFromLocalStorage = (key: string, defaultValue: any = null) => {
  try {
    const item = localStorage.getItem(key);
    return item ? JSON.parse(item) : defaultValue;
  } catch (error) {
    console.error('Error loading from localStorage:', error);
    return defaultValue;
  }
};

