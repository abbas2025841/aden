                  <div className="absolute top-2 right-2">
                    <span className="text-2xl bg-white bg-opacity-80 rounded-full p-2">{facility.icon}</span>
                  </div>
                  {facility.availability.emergency && (
                    <div className="absolute top-2 left-2">
                      <span className="px-2 py-1 bg-red-500 text-white text-xs rounded-full font-medium">
                        Ø·ÙˆØ§Ø±Ø¦
                      </span>
                    </div>
                  )}
                </div>
              )}
              
              <div className="p-6">
              <div className="flex items-start justify-between mb-4">
                <div>
                  <h3 className="text-lg font-semibold text-gray-900">{facility.name}</h3>
                  <p className="text-sm text-gray-600 capitalize">
                    {facility.type === 'hospital' ? 'Ù…Ø³ØªØ´ÙÙ‰' :
                     facility.type === 'clinic' ? 'Ø¹ÙŠØ§Ø¯Ø©' :
                       facility.type === 'pharmacy' ? 'ØµÙŠØ¯Ù„ÙŠØ©' :
                       facility.type === 'laboratory' ? 'Ù…Ø®ØªØ¨Ø±' :
                       facility.type === 'dental' ? 'Ø¹ÙŠØ§Ø¯Ø© Ø£Ø³Ù†Ø§Ù†' :
                       facility.type === 'specialized' ? 'Ù…ØªØ®ØµØµ' : facility.type}
                  </p>
                    <p className="text-xs text-gray-500 mt-1">{facility.category === 'public' ? 'Ø­ÙƒÙˆÙ…ÙŠ' : facility.category === 'private' ? 'Ø®Ø§Øµ' : 'Ø®ÙŠØ±ÙŠ'}</p>
                </div>
                <div className="flex flex-col items-end gap-2">
                    {!facility.images?.main && (
                      <span className="text-2xl">{facility.icon}</span>
                    )}
                    {facility.rating && (
                      <div className="flex items-center gap-1">
                        <span className="text-yellow-500">â­</span>
                        <span className="text-xs text-gray-600">{facility.rating}</span>
                      </div>
                    )}
                </div>
              </div>

              <div className="space-y-3">
                <div className="flex items-center text-gray-600">
                  <span className="mr-2">ðŸ“</span>
                  <span className="text-sm">{facility.address}</span>
                </div>

                <div className="flex items-center text-gray-600">
                  <span className="mr-2">ðŸ˜ï¸</span>
                  <span className="text-sm">{facility.district}</span>
                  </div>

                {facility.contact?.phone && facility.contact.phone.length > 0 && (
                <div className="flex items-center text-gray-600">
                  <span className="mr-2">ðŸ“ž</span>
                    <a href={`tel:${facility.contact.phone[0]}`} className="text-sm text-blue-600 hover:underline">
                      {facility.contact.phone[0]}
                  </a>
                  </div>
                )}

                <div className="flex items-center text-gray-600">
                  <span className="mr-2">ðŸ•’</span>
                  <span className="text-sm">{facility.workingHours}</span>
                  </div>

                <div className="mt-4">
                  <h4 className="text-sm font-medium text-gray-700 mb-2">Ø§Ù„Ø®Ø¯Ù…Ø§Øª Ø§Ù„Ù…ØªØ§Ø­Ø©:</h4>
                  <div className="flex flex-wrap gap-1">
                    {facility.services.slice(0, 4).map((service) => (
                    <span
                        key={service}
                        className="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full"
                    >
                      {service}
                    </span>
                  ))}
                  {facility.services.length > 4 && (
                    <span className="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded-full">
                      +{facility.services.length - 4} Ø£Ø®Ø±Ù‰
                    </span>
                  )}
                </div>
              </div>

                <div className="mt-4 flex gap-2">
                  {facility.availability.appointments && (
                  <button className="flex-1 bg-blue-600 text-white py-2 px-4 rounded-lg hover:bg-blue-700 transition-colors">
                    Ø§Ø­Ø¬Ø² Ù…ÙˆØ¹Ø¯
                    </button>
                  )}
                  <button 
                    onClick={() => openMap(facility.position, facility.name)}
                    className="flex-1 bg-green-600 text-white py-2 px-4 rounded-lg hover:bg-green-700 transition-colors"
                  >
                    ðŸ—ºï¸ Ø§Ù„Ø®Ø±ÙŠØ·Ø©
                  </button>
                  {facility.images?.gallery && facility.images.gallery.length > 0 && (
                    <button 
                      onClick={() => openImageGallery(facility)}
                      className="flex-1 bg-purple-600 text-white py-2 px-4 rounded-lg hover:bg-purple-700 transition-colors"
                    >
                      📸 الصور
                    </button>
                  )}
                  <button className="flex-1 bg-gray-100 text-gray-700 py-2 px-4 rounded-lg hover:bg-gray-200 transition-colors">
                    المزيد
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <AppFooter />
    </div>
  );
}



