<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
  <!-- Background Circle -->
  <circle cx="256" cy="256" r="240" fill="#1E40AF" stroke="#3B82F6" stroke-width="8"/>
  
  <!-- Aden City Skyline -->
  <!-- Building 1 -->
  <rect x="80" y="180" width="40" height="120" fill="#F59E0B" rx="4"/>
  <rect x="85" y="200" width="30" height="15" fill="#1E40AF" rx="2"/>
  <rect x="85" y="225" width="30" height="15" fill="#1E40AF" rx="2"/>
  <rect x="85" y="250" width="30" height="15" fill="#1E40AF" rx="2"/>
  
  <!-- Building 2 -->
  <rect x="130" y="160" width="35" height="140" fill="#10B981" rx="4"/>
  <rect x="135" y="180" width="25" height="12" fill="#1E40AF" rx="2"/>
  <rect x="135" y="200" width="25" height="12" fill="#1E40AF" rx="2"/>
  <rect x="135" y="220" width="25" height="12" fill="#1E40AF" rx="2"/>
  <rect x="135" y="240" width="25" height="12" fill="#1E40AF" rx="2"/>
  
  <!-- Building 3 (Tallest) -->
  <rect x="180" y="140" width="45" height="160" fill="#EF4444" rx="4"/>
  <rect x="185" y="160" width="35" height="15" fill="#1E40AF" rx="2"/>
  <rect x="185" y="185" width="35" height="15" fill="#1E40AF" rx="2"/>
  <rect x="185" y="210" width="35" height="15" fill="#1E40AF" rx="2"/>
  <rect x="185" y="235" width="35" height="15" fill="#1E40AF" rx="2"/>
  <rect x="185" y="260" width="35" height="15" fill="#1E40AF" rx="2"/>
  
  <!-- Building 4 -->
  <rect x="240" y="170" width="38" height="130" fill="#8B5CF6" rx="4"/>
  <rect x="245" y="190" width="28" height="12" fill="#1E40AF" rx="2"/>
  <rect x="245" y="210" width="28" height="12" fill="#1E40AF" rx="2"/>
  <rect x="245" y="230" width="28" height="12" fill="#1E40AF" rx="2"/>
  <rect x="245" y="250" width="28" height="12" fill="#1E40AF" rx="2"/>
  
  <!-- Building 5 -->
  <rect x="290" y="185" width="42" height="115" fill="#F97316" rx="4"/>
  <rect x="295" y="205" width="32" height="12" fill="#1E40AF" rx="2"/>
  <rect x="295" y="225" width="32" height="12" fill="#1E40AF" rx="2"/>
  <rect x="295" y="245" width="32" height="12" fill="#1E40AF" rx="2"/>
  <rect x="295" y="265" width="32" height="12" fill="#1E40AF" rx="2"/>
  
  <!-- Building 6 -->
  <rect x="345" y="175" width="35" height="125" fill="#06B6D4" rx="4"/>
  <rect x="350" y="195" width="25" height="12" fill="#1E40AF" rx="2"/>
  <rect x="350" y="215" width="25" height="12" fill="#1E40AF" rx="2"/>
  <rect x="350" y="235" width="25" height="12" fill="#1E40AF" rx="2"/>
  <rect x="350" y="255" width="25" height="12" fill="#1E40AF" rx="2"/>
  
  <!-- Aden Port (Bottom) -->
  <rect x="60" y="320" width="320" height="40" fill="#0EA5E9" rx="20"/>
  <rect x="80" y="330" width="20" height="20" fill="#1E40AF" rx="10"/>
  <rect x="120" y="330" width="20" height="20" fill="#1E40AF" rx="10"/>
  <rect x="160" y="330" width="20" height="20" fill="#1E40AF" rx="10"/>
  <rect x="200" y="330" width="20" height="20" fill="#1E40AF" rx="10"/>
  <rect x="240" y="330" width="20" height="20" fill="#1E40AF" rx="10"/>
  <rect x="280" y="330" width="20" height="20" fill="#1E40AF" rx="10"/>
  <rect x="320" y="330" width="20" height="20" fill="#1E40AF" rx="10"/>
  
  <!-- Sun -->
  <circle cx="400" cy="120" r="25" fill="#FCD34D"/>
  <circle cx="400" cy="120" r="20" fill="#FEF3C7"/>
  
  <!-- Sun Rays -->
  <line x1="400" y1="80" x2="400" y2="70" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
  <line x1="430" y1="120" x2="440" y2="120" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
  <line x1="400" y1="160" x2="400" y2="170" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
  <line x1="370" y1="120" x2="360" y2="120" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
  <line x1="415" y1="85" x2="420" y2="80" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
  <line x1="415" y1="155" x2="420" y2="160" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
  <line x1="385" y1="85" x2="380" y2="80" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
  <line x1="385" y1="155" x2="380" y2="160" stroke="#FCD34D" stroke-width="3" stroke-linecap="round"/>
  
  <!-- Text: Aden -->
  <text x="256" y="420" font-family="Arial, sans-serif" font-size="32" font-weight="bold" text-anchor="middle" fill="#FFFFFF">عدن</text>
  <text x="256" y="450" font-family="Arial, sans-serif" font-size="16" text-anchor="middle" fill="#E5E7EB">Aden</text>
</svg>
