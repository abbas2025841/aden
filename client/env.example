# مفاتيح API لأسعار العملات
# احصل على مفتاح مجاني من: https://fixer.io/
FIXER_API_KEY=your_fixer_api_key_here

# مفاتيح API بديلة
# ExchangeRate-API: https://exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here

# CurrencyLayer API: https://currencylayer.com/
CURRENCY_LAYER_API_KEY=your_currency_layer_api_key_here

# إعدادات التطبيق
VITE_APP_NAME=Aden Live
VITE_APP_VERSION=3.0.0
VITE_APP_ENVIRONMENT=development

# إعدادات API
VITE_API_BASE_URL=http://localhost:3017/api
VITE_CURRENCY_UPDATE_INTERVAL=300000

# إعدادات الخرائط
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
